# Ignore everything by default; this directory contains credentials, logs, caches,
# session transcripts, SQLite state, and bundled plugin/runtime files.
*

# Keep this repository policy.
!.gitignore
!AGENTS.md
!SETUP.md
!shared.config.toml
!hooks.json

# Portable Codex configuration directories.
!rules/
!rules/**
!scripts/
!scripts/**
scripts/__pycache__/
scripts/**/*.pyc
!skills/
!skills/**
skills/**/__pycache__/
skills/**/*.pyc

# Never track sensitive or high-churn local state.
auth.json
config.json
config.toml
.setup-complete
history.json
history.jsonl
instructions.md
installation_id
session_index.jsonl
version.json
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.log
.code-review-graph/
.codex-global-state.json
.codex-global-state.json.bak
.personality_migration
.tmp/
ambient-suggestions/
archived_sessions/
cache/
claude-cowork-import-history.json
claude-cowork-transcript-imports/
computer-use/
external_agent_session_imports.json
log/
logs/
memories/
models_cache.json
plugins/
sessions/
shell_snapshots/
sqlite/
tmp/
vendor_imports/
